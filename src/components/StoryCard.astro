---
import { getGenreName } from '../data/genres';
import { formatChapterCount, formatReadingTime, t } from '../i18n/id';
import type { Story } from '../lib/stories';

interface Props {
  story: Story;
}

const { story } = Astro.props;
const { data } = story;
const isNovel = data.category === 'novel';
const footer = [
  data.genres.slice(0, 3).map(getGenreName).join(', '),
  isNovel ? formatChapterCount(story.chapters.length) : formatReadingTime(story.readingMinutes),
].join(' · ');
---

<article class="card">
  <h2 class="title">
    <a href={`/cerita/${story.slug}`}>{data.title}</a>
  </h2>
  <p class="meta ui muted">
    {story.author.data.name} · {t.category[data.category]} · {t.status[data.status]}
  </p>
  <p class="synopsis">{data.synopsis}</p>
  <p class="meta ui muted">{footer}</p>
</article>

<style>
  .card {
    position: relative;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
  }

  .title {
    margin: 0 0 0.25rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .title a {
    text-decoration: none;
  }

  /* Make the whole card clickable while keeping a single link in the accessibility tree. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .meta {
    margin: 0;
    font-size: 0.875rem;
  }

  .synopsis {
    margin: 0.5rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
