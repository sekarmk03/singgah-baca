---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ProgressRibbon from '../../../components/ProgressRibbon.astro';
import ReaderSettings from '../../../components/ReaderSettings.astro';
import ReaderToolbar from '../../../components/ReaderToolbar.astro';
import { formatChapterPosition, formatReadingTime, t } from '../../../i18n/id';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getStories, type Chapter, type Story } from '../../../lib/stories';
import { chapterJsonLd } from '../../../lib/structured-data';

export const getStaticPaths = (async () => {
  const stories = await getStories();
  return stories.flatMap((story) =>
    story.chapters.map((chapter, index) => ({
      params: { slug: story.slug, chapter: chapter.slug },
      props: { story, index },
    })),
  );
}) satisfies GetStaticPaths;

interface Props {
  story: Story;
  index: number;
}

const { story, index } = Astro.props;
const chapter: Chapter = story.chapters[index];
const isNovel = story.data.category === 'novel';
const { Content } = await render(chapter.entry);

const storyUrl = `/cerita/${story.slug}`;
const chapterUrl = (slug: string) => `${storyUrl}/${slug}`;
const previousUrl = index > 0 ? chapterUrl(story.chapters[index - 1].slug) : undefined;
const nextUrl =
  index < story.chapters.length - 1 ? chapterUrl(story.chapters[index + 1].slug) : undefined;
const pageTitle = isNovel ? `${chapter.title} · ${story.data.title}` : story.data.title;
const pickerChapters = isNovel
  ? story.chapters.map((item) => ({
      url: chapterUrl(item.slug),
      label: `${item.order}. ${item.title}`,
      current: item.slug === chapter.slug,
    }))
  : undefined;
---

<BaseLayout
  title={pageTitle}
  description={story.data.synopsis}
  type="article"
  image={story.data.cover?.src ?? `/og/${story.slug}.png`}
  imageSize={story.data.cover && { width: story.data.cover.width, height: story.data.cover.height }}
  jsonLd={chapterJsonLd(story, chapter, Astro.site!)}
>
  <ReaderToolbar storyTitle={story.data.title} storyUrl={storyUrl} chapters={pickerChapters} />
  <main
    id="main"
    class="reader"
    data-reader
    data-story={story.slug}
    data-chapter={chapter.slug}
    data-chapter-order={chapter.order}
    data-previous-url={previousUrl}
    data-next-url={nextUrl}
  >
    <ProgressRibbon />
    <header class="chapter-header">
      {isNovel && <p class="ui muted">{story.data.title}</p>}
      <h1>{isNovel ? chapter.title : story.data.title}</h1>
      <p class="ui muted position">
        {isNovel && `${formatChapterPosition(chapter.order, story.chapters.length)} · `}
        {formatReadingTime(chapter.readingMinutes)}
      </p>
    </header>
    <article class="prose" lang="id" data-prose>
      <Content />
    </article>
    <nav class="chapter-nav ui" aria-label={t.reader.chapterNav}>
      {previousUrl && (
        <a href={previousUrl} rel="prev">
          ← {t.reader.previous}
        </a>
      )}
      {nextUrl && (
        <a class="next" href={nextUrl} rel="next">
          {t.reader.next} →
        </a>
      )}
      {!nextUrl && <p class="end">{t.status[story.data.status]}</p>}
    </nav>
  </main>
  <ReaderSettings />
</BaseLayout>

<script>
  import '../../../scripts/reader';
</script>

<style>
  .reader {
    max-width: var(--reader-measure);
    margin: 0 auto;
    padding: calc(56px + env(safe-area-inset-top) + 1rem) var(--page-gutter) 4rem;
    font-size: var(--reader-font-size);
  }

  .chapter-header {
    margin: 2rem 0 2.5rem;
    text-align: center;
  }

  .chapter-header p {
    margin: 0;
    font-size: 0.8125rem;
  }

  h1 {
    margin: 0.5rem 0;
    font-size: 1.75em;
    font-weight: 600;
    line-height: 1.25;
  }

  .prose {
    line-height: var(--reader-leading);
    hyphens: auto;
    -webkit-hyphens: auto;
    text-align: left;
  }

  /* Justify only on wider screens, and only when hyphenation works or the reader asked for it. */
  @media (min-width: 520px) {
    :global(:root[data-justify='true']) .prose {
      text-align: justify;
    }
  }

  .prose :global(p) {
    margin: 0;
    text-indent: 1.6em;
  }

  /* The first paragraph of a chapter and after a scene break starts flush, novel style. */
  .prose :global(p:first-child),
  .prose :global(hr + p) {
    text-indent: 0;
  }

  .prose :global(p:first-child::first-letter) {
    float: left;
    margin: 0.08em 0.1em 0 0;
    color: var(--color-accent);
    font-size: 3.4em;
    font-weight: 600;
    line-height: 0.8;
  }

  .prose :global(p:first-child::first-line) {
    font-variant-caps: small-caps;
    letter-spacing: 0.03em;
  }

  /* Scene break: Markdown `***` renders as <hr>, shown as "* * *". */
  .prose :global(hr) {
    margin: 1.5em 0;
    border: 0;
    text-align: center;
  }

  .prose :global(hr)::after {
    content: '*\2003*\2003*';
    color: var(--color-text-muted);
  }

  .chapter-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }

  .chapter-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-size);
  }

  .next {
    margin-left: auto;
  }

  .end {
    margin: 0 0 0 auto;
    align-self: center;
    font-family: var(--font-serif);
    font-style: italic;
  }
</style>
