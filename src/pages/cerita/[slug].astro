---
import type { GetStaticPaths } from 'astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getGenreName } from '../../data/genres';
import { formatChapterCount, formatDate, formatReadingTime, t } from '../../i18n/id';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStories, type Story } from '../../lib/stories';

export const getStaticPaths = (async () => {
  const stories = await getStories();
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}) satisfies GetStaticPaths;

interface Props {
  story: Story;
}

const { story } = Astro.props;
const { data } = story;
const [firstChapter] = story.chapters;
const isNovel = data.category === 'novel';
const chapterLinks = story.chapters.map((chapter) => ({
  slug: chapter.slug,
  url: `/cerita/${story.slug}/${chapter.slug}`,
  label: isNovel ? `Bab ${chapter.order} · ${chapter.title}` : '',
}));
---

<BaseLayout title={data.title} description={data.synopsis}>
  <SiteHeader />
  <main id="main" class="page detail">
    <p class="ui muted category">
      {t.category[data.category]} · {t.status[data.status]}
    </p>
    <h1>{data.title}</h1>
    <p class="ui byline">
      {t.story.by} <a href={`/penulis/${story.author.id}`}>{story.author.data.name}</a>
    </p>
    <p class="ui muted">
      {data.genres.map((genre, index) => (
        <>
          {index > 0 && ', '}
          <a href={`/genre/${genre}`}>{getGenreName(genre)}</a>
        </>
      ))}{' '}
      · {isNovel ? `${formatChapterCount(story.chapters.length)} · ` : ''}
      {formatReadingTime(story.readingMinutes)}
    </p>
    <p class="synopsis">{data.synopsis}</p>
    <div
      class="start"
      data-continue
      data-story={story.slug}
      data-chapters={JSON.stringify(chapterLinks)}
    >
      <a class="ui button" href={`/cerita/${story.slug}/${firstChapter.slug}`}>
        {t.story.start}
      </a>
      <p class="ui muted last-read" hidden></p>
    </div>

    {isNovel && (
      <section aria-labelledby="chapters-heading">
        <h2 id="chapters-heading">{t.story.chapters}</h2>
        <ol class="chapters">
          {story.chapters.map((chapter) => (
            <li>
              <a href={`/cerita/${story.slug}/${chapter.slug}`}>{chapter.title}</a>
              {chapter.publishedAt && (
                <span class="ui muted date">{formatDate(chapter.publishedAt)}</span>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}
  </main>
</BaseLayout>

<script>
  import '../../scripts/story-detail';
</script>

<style>
  .detail {
    max-width: 42rem;
  }

  .category {
    margin: 1rem 0 0;
    font-size: 0.875rem;
  }

  h1 {
    margin: 0.25rem 0;
    font-size: 2rem;
    line-height: 1.2;
  }

  .byline {
    margin: 0 0 0.25rem;
  }

  .synopsis {
    font-size: 1.0625rem;
  }

  .last-read {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
  }

  h2 {
    margin-top: 2.5rem;
    font-size: 1.25rem;
  }

  .chapters {
    padding-left: 1.5rem;
  }

  .chapters li {
    padding: 0.5rem 0;
  }

  .chapters a {
    display: inline-block;
    min-height: var(--tap-size);
    padding: 0.5rem 0;
  }

  .date {
    display: block;
    font-size: 0.8125rem;
  }
</style>
