---
import type { GetStaticPaths } from 'astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getGenreName } from '../../data/genres';
import { formatChapterCount, formatDate, formatReadingTime, t } from '../../i18n/id';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStories, type Story } from '../../lib/stories';

export const getStaticPaths = (async () => {
  const stories = await getStories();
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}) satisfies GetStaticPaths;

interface Props {
  story: Story;
}

const { story } = Astro.props;
const { data } = story;
const [firstChapter] = story.chapters;
const isNovel = data.category === 'novel';
---

<BaseLayout title={data.title} description={data.synopsis}>
  <SiteHeader />
  <main id="main" class="page detail">
    <p class="ui muted category">
      {t.category[data.category]} · {t.status[data.status]}
    </p>
    <h1>{data.title}</h1>
    <p class="ui byline">
      {t.story.by} {story.author.data.name}
    </p>
    <p class="ui muted">
      {data.genres.map(getGenreName).join(', ')} ·{' '}
      {isNovel ? `${formatChapterCount(story.chapters.length)} · ` : ''}
      {formatReadingTime(story.readingMinutes)}
    </p>
    <p class="synopsis">{data.synopsis}</p>
    <a class="ui button" href={`/cerita/${story.slug}/${firstChapter.slug}`}>
      {t.story.start}
    </a>

    {isNovel && (
      <section aria-labelledby="chapters-heading">
        <h2 id="chapters-heading">{t.story.chapters}</h2>
        <ol class="chapters">
          {story.chapters.map((chapter) => (
            <li>
              <a href={`/cerita/${story.slug}/${chapter.slug}`}>{chapter.title}</a>
              {chapter.publishedAt && (
                <span class="ui muted date">{formatDate(chapter.publishedAt)}</span>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .detail {
    max-width: 42rem;
  }

  .category {
    margin: 1rem 0 0;
    font-size: 0.875rem;
  }

  h1 {
    margin: 0.25rem 0;
    font-size: 2rem;
    line-height: 1.2;
  }

  .byline {
    margin: 0 0 0.25rem;
  }

  .synopsis {
    font-size: 1.0625rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-size);
    padding: 0 1.25rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-weight: 600;
    text-decoration: none;
  }

  h2 {
    margin-top: 2.5rem;
    font-size: 1.25rem;
  }

  .chapters {
    padding-left: 1.5rem;
  }

  .chapters li {
    padding: 0.5rem 0;
  }

  .chapters a {
    display: inline-block;
    min-height: var(--tap-size);
    padding: 0.5rem 0;
  }

  .date {
    display: block;
    font-size: 0.8125rem;
  }
</style>
