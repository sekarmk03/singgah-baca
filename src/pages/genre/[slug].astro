---
import type { GetStaticPaths } from 'astro';
import { StoryCard } from '../../components/catalog/StoryCard';
import SiteHeader from '../../components/SiteHeader.astro';
import { genres } from '../../data/genres';
import { formatGenreDescription, formatGenreTitle, formatStoryCount, t } from '../../i18n/id';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toCatalogEntry } from '../../lib/catalog-entry';
import { getStories } from '../../lib/stories';

export const getStaticPaths = (async () => {
  const stories = await getStories();
  // Only genres with at least one story get a page.
  return genres.flatMap((genre) => {
    const entries = stories
      .filter((story) => story.data.genres.includes(genre.slug))
      .map(toCatalogEntry);
    return entries.length
      ? [{ params: { slug: genre.slug }, props: { name: genre.name, entries } }]
      : [];
  });
}) satisfies GetStaticPaths;

const { name, entries } = Astro.props;
const { slug } = Astro.params;
---

<BaseLayout title={formatGenreTitle(name)} description={formatGenreDescription(name)}>
  <SiteHeader />
  <main id="main" class="page">
    <h1>{formatGenreTitle(name)}</h1>
    <p class="ui muted lead">
      {formatStoryCount(entries.length)} · <a href={`/?genre=${slug}`}>{t.genrePage.refine}</a>
    </p>
    <div class="story-grid story-grid--wide">
      {entries.map((entry) => (
        <StoryCard entry={entry} />
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  h1 {
    margin: 1rem 0 0.25rem;
    font-size: 1.75rem;
  }

  .lead {
    margin: 0 0 1.5rem;
  }

  .lead a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-size);
  }
</style>
