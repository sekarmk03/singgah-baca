---
import Catalog from '../components/catalog/Catalog';
import SiteHeader from '../components/SiteHeader.astro';
import { genres } from '../data/genres';
import { t } from '../i18n/id';
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMPTY_STATE, PAGE_SIZE, runCatalog } from '../lib/catalog';
import { toCatalogEntry } from '../lib/catalog-entry';
import { getStories } from '../lib/stories';

const stories = await getStories();
const entries = stories.map(toCatalogEntry);
const initial = runCatalog(entries, EMPTY_STATE, undefined);

const authors = [...new Map(entries.map((entry) => [entry.authorSlug, entry.authorName]))]
  .map(([slug, name]) => ({ slug, name }))
  .sort((a, b) => a.name.localeCompare(b.name, 'id'));
---

<BaseLayout>
  <SiteHeader />
  <main id="main" class="page">
    <h1>{t.catalog.heading}</h1>
    {entries.length === 0 ? (
      <p class="muted">{t.catalog.empty}</p>
    ) : (
      <Catalog
        client:load
        initialEntries={initial.entries.slice(0, PAGE_SIZE)}
        initialFacets={initial.facets}
        initialTotal={entries.length}
        genres={genres.map(({ slug, name }) => ({ slug, name }))}
        authors={authors}
      />
    )}
  </main>
</BaseLayout>

<style>
  h1 {
    margin: 1rem 0;
    font-size: 1.75rem;
  }
</style>
